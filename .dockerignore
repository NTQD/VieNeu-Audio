# Chỉ dùng khi Dockerfile chuyển sang `COPY . .` — hiện Dockerfile COPY chọn
# lọc từng phần (pyproject.toml, src/, pipeline/, voxdirector/) nên file này
# chủ yếu để phòng hờ/dọn build context.
.git/
.github/
outputs/
# .venv/ is ~1GB with tens of thousands of files — walking it is what made
# the build context step hang for 80+ minutes before this was added.
.venv/
venv/
.chroma/
.voice_cache/
__pycache__/
*.pyc
.pytest_cache/
tests/
finetune/
apps/
examples/
docs/
*.md
!README_PYPI.md
*.ipynb
*.zip
.mcp.json
.claude/
