# Chỉ dùng khi Dockerfile chuyển sang `COPY . .` — hiện Dockerfile COPY chọn
# lọc từng phần (pyproject.toml, src/, pipeline/, voxdirector/) nên file này
# chủ yếu để phòng hờ/dọn build context.
.git/
.github/
outputs/
# .venv/ is ~1GB with tens of thousands of files — walking it is what made
# the build context step hang for 80+ minutes before this was added.
.venv/
venv/
.chroma/
.voice_cache/
__pycache__/
*.pyc
.pytest_cache/
tests/
finetune/
apps/
examples/
docs/
*.md
!README_PYPI.md
*.ipynb
*.zip
.mcp.json
.claude/

# VoxDirector backend/Dockerfile dung context "." (goc repo) nhung chi COPY
# chon loc voxdirector/, pipeline/, data/, backend/app/ - loai bo cac thu
# muc nang khong lien quan de build context khong bi cham nhu .venv/ o tren.
frontend/node_modules/
frontend/.next/
backend/.venv/
backend/app/_jobs/
scratch_check/out/

