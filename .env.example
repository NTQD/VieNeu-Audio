# Tên của Docker Image
IMAGE_NAME=vieneu-tts

# Tag của Docker Image
IMAGE_TAG=latest

# Port ứng dụng (Host)
PORT=7860

# Config cho HuggingFace
# HF_TOKEN=hf_... 

# Config cho System
# UID/GID để mapping quyền file (nếu cần trên Linux)
# USER_ID=1000
# GROUP_ID=1000



HF_HOME=/root/.cache/huggingface
PYTHONUNBUFFERED=1
PHONEMIZER_ESPEAK_LIBRARY=/usr/lib/x86_64-linux-gnu/libespeak-ng.so.1

GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=0

# ===== VoxDirector AI (docker-compose.yml o goc repo, Section 12 cua spec) =====
# Dung chung cho ca voxdirector/llm_client.py (khi chay local, khong qua
# Docker) VA backend container (bien moi truong trong docker-compose.yml).
GEMINI_API_KEY=

# Frontend build-time (Next.js inline gia tri nay vao bundle client luc
# build, khong doc duoc luc container chay). ĐỂ TRỐNG cho che do Docker
# Compose (khuyen nghi, xem docs/voxdirector/RUNNING.md) - nginx la 1 origin
# duy nhat, frontend goi API bang duong dan tuong doi, khong can bien nay.
# CHI dat gia tri (vd. http://localhost:8000) khi chay "local dev servers"
# KHONG qua Docker/nginx - dat gia tri o day tung gay ERR_CONNECTION_REFUSED
# that trong che do Docker (2026-09-10) vi cong 8000 cua backend khong
# publish ra host.
NEXT_PUBLIC_API_URL=